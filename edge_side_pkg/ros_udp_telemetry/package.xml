<?xml version="1.0"?>
<package format="2">
  <name>ros_udp_telemetry</name>
  <version>0.2.1</version>
  <description>Configurable ROS and MAVROS telemetry uplink over UDP.</description>
  <maintainer email="maintainer@example.com">CCS Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>roslib</build_depend>
  <build_depend>edge_device_config</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>roslib</exec_depend>
  <exec_depend>edge_device_config</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-msgpack</exec_depend>
  <test_depend>python3-nose</test_depend>
  <export />
</package>
