<launch>
  <arg name="task_config_file" default="$(find epgeneral_device_config)/config/task_control.yaml" />
  <arg name="device_config_file" default="$(find epgeneral_device_config)/config/device.yaml" />
  <node pkg="epgeneral_task_control" type="epgeneral_task_control_node.py"
        name="epgeneral_task_control" output="screen" required="true">
    <param name="task_config_file" value="$(arg task_config_file)" />
    <param name="device_config_file" value="$(arg device_config_file)" />
  </node>
  <node pkg="epgeneral_ground_air_control" type="ground_air_task_adapter_node.py"
        name="epgeneral_ground_air_task_adapter" output="screen" required="true">
    <param name="task_config_file" value="$(arg task_config_file)" />
    <param name="device_config_file" value="$(arg device_config_file)" />
  </node>
</launch>
