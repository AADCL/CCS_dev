<?xml version="1.0"?>
<package format="2">
  <name>epgeneral_mqtav</name>
  <version>0.4.1</version>
  <description>ROS1 MAVROS health telemetry uplink for an MQTT ground station.</description>
  <maintainer email="maintainer@example.com">epgeneral_mqtav Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>epgeneral_device_config</build_depend>
  <build_depend>roslib</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>epgeneral_device_config</exec_depend>
  <exec_depend>roslib</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <test_depend>python3-nose</test_depend>

  <export />
</package>
